{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "SENDGRID_API_KEY",
        "STRIPE_SECRET_KEY",
        "CLIENT_URL",
        "PAYPAL_CLIENT_ID",
        "PAYPAL_SECRET",
        "PAYPAL_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
