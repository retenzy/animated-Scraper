{
  "manifest_version": 3,
  "name": "Amazon Reviews Extractor",
  "version": "1.0.0",
  "description": "Extract product reviews from Amazon pages and export them as CSV",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://localhost:3000/*"],
      "js": ["website-content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.com.au/*",
    "*://*.amazon.com.br/*",
    "*://*.amazon.com.mx/*",
    "*://*.amazon.sg/*",
    "*://*.amazon.ae/*",
    "*://*.amazon.sa/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
