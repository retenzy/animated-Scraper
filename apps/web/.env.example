DATABASE_URL="postgresql://..."
PAYLOAD_SECRET="your-long-random-payload-secret"
AUTH_SECRET="your-secret-key"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
SENDGRID_API_KEY="your-sendgrid-api-key"
# Sender for OTP emails — must be a verified Sender Identity in SendGrid,
# otherwise the API rejects every send with 403 "from address does not match".
EMAIL_FROM="noreply@retenzyreviews.com"
EMAIL_FROM_NAME="Retenzy"
STRIPE_SECRET_KEY="your-stripe-secret-key" # legacy — unused now
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_SECRET="your-paypal-secret"
PAYPAL_ENV="sandbox" # sandbox | live
CLIENT_URL="https://retenzyreviews.com"
# Upstash Redis (Vercel KV) — used for extension registration lookup (see lib/redis.ts)
# Auto-provisioned via `vercel integration add upstash-kv`
KV_REST_API_URL="your-kv-rest-url"
KV_REST_API_TOKEN="your-kv-rest-token"
REDIS_URL="rediss://..." # optional: connection string for local tooling
