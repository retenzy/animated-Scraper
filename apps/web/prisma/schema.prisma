  answer             String?            @db.VarChar
  uuid               String?            @map("_uuid") @db.VarChar
  pages_v_blocks_faq pages_v_blocks_faq @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "_pages_v_blocks_faq_items_parent_id_fk")

  @@index([order], map: "_pages_v_blocks_faq_items_order_idx")
