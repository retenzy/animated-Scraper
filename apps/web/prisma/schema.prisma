model landing_page {
  id                              Int                               @id @default(autoincrement())
  seo_title                       String?                           @db.VarChar
  seo_description                 String?                           @db.VarChar
  seo_keywords                    String?                           @db.VarChar
  seo_og_image                    String?                           @db.VarChar
  navbar_logo_url                 String?                           @db.VarChar
  navbar_logo_text                String?                           @db.VarChar
  navbar_login_label              String?                           @default("Log in") @db.VarChar
  navbar_cta_label                String?                           @default("Get started") @db.VarChar
  hero_badge                      String?                           @db.VarChar
  hero_title                      String?                           @db.VarChar
  hero_highlighted_text           String?                           @db.VarChar
  hero_subtitle                   String?                           @db.VarChar
  hero_primary_cta_label          String?                           @default("Get started") @db.VarChar
  hero_secondary_cta_label        String?                           @default("Install extension") @db.VarChar
  features_heading                String?                           @db.VarChar
  features_subheading             String?                           @db.VarChar
  statistics_heading              String?                           @db.VarChar
  statistics_subheading           String?                           @db.VarChar
  how_it_works_heading            String?                           @db.VarChar
  how_it_works_subheading         String?                           @db.VarChar
  how_it_works_benefits_title     String?                           @db.VarChar
  testimonials_heading            String?                           @db.VarChar
  testimonials_subheading         String?                           @db.VarChar
  faq_heading                     String?                           @db.VarChar
  faq_subheading                  String?                           @db.VarChar
  cta_heading                     String?                           @db.VarChar
  cta_subtitle                    String?                           @db.VarChar
  cta_button_label                String?                           @default("Get started") @db.VarChar
  footer_brand_name               String?                           @db.VarChar
  footer_tagline                  String?                           @db.VarChar
  footer_copyright                String?                           @db.VarChar
  updated_at                      DateTime?                         @db.Timestamptz(3)
  created_at                      DateTime?                         @db.Timestamptz(3)
  landing_page_faq_items          landing_page_faq_items[]
  landing_page_features_items     landing_page_features_items[]
  landing_page_footer_links       landing_page_footer_links[]
  landing_page_hero_stats         landing_page_hero_stats[]
  landing_page_how_it_works_steps landing_page_how_it_works_steps[]
  landing_page_navbar_nav_links   landing_page_navbar_nav_links[]
  landing_page_statistics_stats   landing_page_statistics_stats[]
  landing_page_testimonials_items landing_page_testimonials_items[]
  landing_page_texts              landing_page_texts[]
